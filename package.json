{
  "name": "easy-copy",
  "displayName": "Easy Copy",
  "description": "Easy Copy is a Visual Studio Code extension that lets you quickly copy the content of selected files and folders directly from the Explorer context menu. It recursively reads file contents, formats them with filenames, and places them on your clipboard — ideal for documentation, reviews, or sharing code snippets.",
  "version": "0.2.0",
  "publisher": "Gnel",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/SedrakyanGnel/easy-copy.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "easy-copy.copy",
        "title": "Easy Copy",
        "category": "Easy Copy",
        "description": "Copy the full content of selected files with file names to clipboard"
      },
      {
        "command": "easy-copy.copyPathsTree",
        "title": "Easy Copy: Paths Tree",
        "category": "Easy Copy",
        "description": "Copy a tree structure of file/folder paths relative to the workspace"
      },
      {
        "command": "easy-copy.copyFiltered",
        "title": "Easy Copy: Filtered",
        "category": "Easy Copy",
        "description": "Copy only files matching filters like intext:user -inname:.g.dart"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "easy-copy.copy",
          "group": "navigation"
        },
        {
          "command": "easy-copy.copyPathsTree",
          "group": "navigation"
        },
        {
          "command": "easy-copy.copyFiltered",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "deploy:local": "vsce package -o dist/easy-copy.vsix && code --install-extension dist/easy-copy.vsix --force",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "18.x",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^7.7.1",
    "@typescript-eslint/parser": "^7.7.1",
    "@vscode/test-cli": "^0.0.8",
    "@vscode/test-electron": "^2.3.9",
    "eslint": "^8.57.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.5",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "minimatch": "^9.0.4"
  }
}